+/* Map a core screen cell to its output rectangle. Cells outside the camera
+ * viewport return false and are skipped. The sidebar, message rows and the
+ * bottom button bar always use the native transform. */
+static boolean hhCellDest(int x, int y, int outputWidth, int outputHeight,
+                          SDL_Rect *dest, int *isZoom) {
+    int mx, my, mapX0, mapY0, mapW, mapH, cx, cy;
+    *isZoom = 0;
+    /* Inventory zoom: ONLY the active menu window is drawn. Everything else
+     * is skipped (the frame is cleared to black first), so the dungeon map,
+     * sidebar, messages and button bar cannot appear over the inventory. */
+    if (hhCameraActive && hhViewMode == 2) {
+        if (x < hhInvSrcX || x >= hhInvSrcX + hhInvSrcW
+            || y < hhCamY || y >= hhCamY + hhInvSrcH) {
+            return false;
+        }
+        dest->x = hhInvOx + (x - hhInvSrcX) * hhInvCellW;
+        dest->w = hhInvCellW;
+        dest->y = hhInvOy + (y - hhCamY) * hhInvCellH;
+        dest->h = hhInvCellH;
+        *isZoom = 1;
+        return true;
+    }
+    /* Stage 6 SCREEN mode: a device-specific 80x24 canvas mapped uniformly
+     * to the whole display. Cells outside it (including the stat sidebar)
+     * are not drawn, so the sidebar can never appear on top of the page. */
+    if (hhCameraActive && hhViewMode == 1) {
+        if (x < 0 || x >= HH_SCREEN_CANVAS_COLS
+            || y < 0 || y >= HH_SCREEN_CANVAS_ROWS) {
+            return false;   /* skipped: no output rect for off-canvas cells */
+        }
+        cx = x;
+        cy = y;
+        dest->x = cx * outputWidth / hhViewCols;
+        dest->w = (cx + 1) * outputWidth / hhViewCols - dest->x;
+        dest->y = cy * outputHeight / hhViewRows;
+        dest->h = (cy + 1) * outputHeight / hhViewRows - dest->y;
+        *isZoom = 1;
+        return true;
+    }
+    if (!hhCameraActive
+            || x < mapToWindowX(0) || x >= COLS
+            || y < MESSAGE_LINES || y >= MESSAGE_LINES + DROWS) {
+        dest->x = x * outputWidth / COLS;
+        dest->y = y * outputHeight / ROWS;
+        dest->w = ((x + 1) * outputWidth / COLS) - (x * outputWidth / COLS);
+        dest->h = ((y + 1) * outputHeight / ROWS) - (y * outputHeight / ROWS);
+        return true;
+    }
+    mx = x - mapToWindowX(0);
+    my = y - MESSAGE_LINES;
+    if (mx < hhCamX || mx >= hhCamX + hhViewCols
+            || my < hhCamY || my >= hhCamY + hhViewRows) {
+        return false;
+    }
+    mapX0 = mapToWindowX(0) * outputWidth / COLS;
+    mapY0 = MESSAGE_LINES * outputHeight / ROWS;
+    mapW = outputWidth - mapX0;
+    mapH = (MESSAGE_LINES + DROWS) * outputHeight / ROWS - mapY0;
+    cx = mx - hhCamX;
+    cy = my - hhCamY;
+    dest->x = mapX0 + cx * mapW / hhViewCols;
+    dest->w = (cx + 1) * mapW / hhViewCols - cx * mapW / hhViewCols;
+    dest->y = mapY0 + cy * mapH / hhViewRows;
+    dest->h = (cy + 1) * mapH / hhViewRows - cy * mapH / hhViewRows;
+    *isZoom = 1;
+    return true;
+}
