# Example local configuration. Copy to .env and adjust; .env is gitignored.
# Scripts also accept these as normal environment variables / CLI overrides.

# Reuse an already-installed Koriki/Batocera SDK instead of downloading.
# Leave unset to download into the default user-level cache:
#   ${XDG_CACHE_HOME:-$HOME/.cache}/brogue-ce-rg35xx/sdk
# BROGUE_SDK=/home/<user>/rg35xx/sdk/koriki-batocera-20240208

# Optional cache root override.
# BROGUE_CACHE_ROOT=/home/<user>/.cache/brogue-ce-rg35xx

# Build parallelism (default 2).
# JOBS=4

# Override build output directories.
# BROGUE_BUILD_DIR=/path/to/build
# BROGUE_DIST_DIR=/path/to/dist

# Extra compiler/linker flags. Set BROGUE_PASS_SYSROOT=1 if the SDK compiler
# does not already know its sysroot (it normally does).
# EXTRA_CFLAGS=
# EXTRA_LDFLAGS=
# BROGUE_PASS_SYSROOT=0
